{
  "name": "agent-id-cli",
  "description": "Portable identity registry and OMP/Pi extension for coding-agent sessions",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerekStride/agent-id-cli.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test:omp": "bun test ./extensions/agent-id.test.ts",
    "test:pi": "node --test extensions/agent-id.pi.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/agent-id.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/agent-id.ts"
    ]
  }
}
